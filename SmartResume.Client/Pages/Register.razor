@page "/register"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@inject HttpClient Http
@inject NavigationManager Navigation
@using SmartResume.Client.Models.Auth;

<PageTitle>Register</PageTitle>

<div class="auth-shell">
    <div class="auth-orb auth-orb-1"></div>
    <div class="auth-orb auth-orb-2"></div>

    <section class="auth-card">
        <h1 class="auth-title">Join <span>SmartCV</span></h1>
        <p class="auth-subtitle">Start optimizing your resume and discover opportunities faster.</p>

        <EditForm Model="@registerModel" OnValidSubmit="@HandleRegistration" FormName="registerForm" class="auth-form">
            <DataAnnotationsValidator />
            <ValidationSummary class="auth-validation-summary" />

            @if (!string.IsNullOrEmpty(apiErrorMessage))
            {
                <div class="auth-alert" role="alert">
                    @apiErrorMessage
                </div>
            }

            <div class="auth-grid">
                <div class="auth-field">
                    <label for="firstName">First Name</label>
                    <InputText id="firstName" class="auth-input" @bind-Value="registerModel.FirstName" />
                    <ValidationMessage For="@(() => registerModel.FirstName)" class="auth-validation-message" />
                </div>

                <div class="auth-field">
                    <label for="lastName">Last Name</label>
                    <InputText id="lastName" class="auth-input" @bind-Value="registerModel.LastName" />
                    <ValidationMessage For="@(() => registerModel.LastName)" class="auth-validation-message" />
                </div>
            </div>

            <div class="auth-field">
                <label for="email">Email</label>
                <InputText id="email" type="email" class="auth-input" @bind-Value="registerModel.Email" />
                <ValidationMessage For="@(() => registerModel.Email)" class="auth-validation-message" />
            </div>

            <div class="auth-field">
                <label for="password">Password</label>
                <InputText id="password" type="password" class="auth-input" @bind-Value="registerModel.Password" />
                <ValidationMessage For="@(() => registerModel.Password)" class="auth-validation-message" />
            </div>

            <div class="auth-field">
                <label for="confirmPassword">Confirm Password</label>
                <InputText id="confirmPassword" type="password" class="auth-input" @bind-Value="registerModel.ConfirmPassword" />
                <ValidationMessage For="@(() => registerModel.ConfirmPassword)" class="auth-validation-message" />
            </div>

            <button type="submit" class="auth-btn">Register</button>
        </EditForm>

        <p class="auth-switch">
            Already have an account?
            <a href="/login">Login</a>
        </p>
    </section>
</div>


@code {
    private RegisterModel registerModel = new RegisterModel();
    private string? apiErrorMessage;

    private async Task HandleRegistration()
    {
        apiErrorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/account/register", registerModel);

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/login");
            }
            else
            {
                var errorResponse = await response.Content.ReadFromJsonAsync<object>();
                apiErrorMessage = "Registration failed. Please check your details and try again.";
            }
        }
        catch (Exception ex)
        {
            apiErrorMessage = "An error occurred while connecting to the server. Please try again later.";
        }
    }
}