@page "/upload-resume"

@using System.Net.Http.Headers
@using Blazored.LocalStorage

@inject HttpClient Http
@inject ILocalStorageService localStorage
@inject NavigationManager Navigation  

<div class="card shadow-sm">
    <div class="card-body">
        <h5 class="card-title mb-3">Upload New Resume</h5>
        <p class="card-text text-muted">Please select a PDF file (Max 10MB).</p>

        @if (!string.IsNullOrEmpty(message))
        {
                <div class="@alertClass" role="alert">
                    @message

                    @if (uploadSuccess)
                    {
                            <div class="mt-3">
                                <button class="btn btn-primary" @onclick="GoToLibrary">
                                    <i class="bi bi-collection-fill me-2"></i> Go to My Library
                                </button>
                                @* İsteğe bağlı: Tekrar yükleme yapmak isterse diye bir link *@
                                <button class="btn btn-outline-secondary ms-2" @onclick="ResetForm">
                                    Upload Another
                                </button>
                            </div>
                    }
                </div>
        }

        @if (!uploadSuccess)
        {
                <div class="mb-3">
                    <InputFile OnChange="@LoadFile" class="form-control" accept=".pdf" />
                </div>
        }

        @if (selectedFile != null && !uploadSuccess)
        {
                <div class="mb-3 p-2 bg-light rounded border">
                    <i class="bi bi-file-earmark-pdf text-danger me-2"></i>
                    <strong>@selectedFile.Name</strong>
                    <span class="text-muted">(@(selectedFile.Size / 1024) KB)</span>
                </div>

                <button class="btn btn-success" @onclick="UploadFile" disabled="@isUploading">
                    @if (isUploading)
                    {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span> Uploading...</span>
                    }
                    else
                    {
                            <span><i class="bi bi-cloud-upload me-2"></i> Upload Now</span>
                    }
                </button>
        }
    </div>
</div>

@code {
    private IBrowserFile? selectedFile;
    private string message = "";
    private string alertClass = "";
    private bool isUploading = false;
    private bool uploadSuccess = false;
    private long maxFileSize = 1024 * 1024 * 10; // 10 MB Limit

    private void LoadFile(InputFileChangeEventArgs e)
    {
        message = "";
        alertClass = "";
        uploadSuccess = false;
        selectedFile = e.File;
    }

    private void GoToLibrary()
    {
        Navigation.NavigateTo("my-resumes");
    }

    private void ResetForm()
    {
        message = "";
        alertClass = "";
        uploadSuccess = false;
        selectedFile = null;
    }

    private async Task UploadFile()
    {
        if (selectedFile == null) return;

        isUploading = true;
        message = "";
        uploadSuccess = false; 

        try
        {
            var token = await localStorage.GetItemAsync<string>("authToken");

            if (string.IsNullOrEmpty(token))
            {
                message = "Session expired. Please login again.";
                alertClass = "alert alert-warning";
                isUploading = false;
                return;
            }

            using var content = new MultipartFormDataContent();

            var fileContent = new StreamContent(selectedFile.OpenReadStream(maxFileSize));
            fileContent.Headers.ContentType = new MediaTypeHeaderValue("application/pdf");

            content.Add(fileContent, "file", selectedFile.Name);

            var request = new HttpRequestMessage(HttpMethod.Post, "api/resume/upload");
            request.Content = content;
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                message = "CV uploaded successfully! You can now view it in your library.";
                alertClass = "alert alert-success";
                uploadSuccess = true; 
                selectedFile = null; 
            }
            else
            {
                message = $"Upload failed: {response.StatusCode} ({response.ReasonPhrase})";
                alertClass = "alert alert-danger";
            }
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
            alertClass = "alert alert-danger";
        }
        finally
        {
            isUploading = false;
        }
    }
}