@page "/login"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider authStateProvider
@inject ILocalStorageService localStorage
@using System.Text.Json.Serialization
@using SmartResume.Client.Models.Auth;
@using System.Text.Json
@using SmartResume.Client.Auth
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Login</PageTitle>

<div class="auth-shell">
    <div class="auth-orb auth-orb-1"></div>
    <div class="auth-orb auth-orb-2"></div>

    <section class="auth-card">
        <h1 class="auth-title">Sign in to <span>SmartCV</span></h1>
        <p class="auth-subtitle">Access your resumes, AI analysis, and job matches.</p>

        <EditForm Model="@loginModel" OnValidSubmit="@HandleLogin" FormName="loginForm" class="auth-form">
            <DataAnnotationsValidator />
            <ValidationSummary class="auth-validation-summary" />

            @if (!string.IsNullOrEmpty(apiErrorMessage))
            {
                <div class="auth-alert" role="alert">
                    @apiErrorMessage
                </div>
            }

            <div class="auth-field">
                <label for="email">Email</label>
                <InputText id="email" type="email" class="auth-input" @bind-Value="loginModel.Email" />
                <ValidationMessage For="@(() => loginModel.Email)" class="auth-validation-message" />
            </div>

            <div class="auth-field">
                <label for="password">Password</label>
                <InputText id="password" type="password" class="auth-input" @bind-Value="loginModel.Password" />
                <ValidationMessage For="@(() => loginModel.Password)" class="auth-validation-message" />
            </div>

            <button type="submit" class="auth-btn" disabled="@isLoggingIn">
                @if (isLoggingIn)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span> Logging in...</span>
                }
                else
                {
                    <span>Login</span>
                }
            </button>
        </EditForm>

        <p class="auth-switch">
            Don't have an account?
            <a href="/register">Create one</a>
        </p>
    </section>
</div>

@code {
    private LoginModel loginModel = new LoginModel();
    private string? apiErrorMessage;
    private bool isLoggingIn = false;

    public class LoginResponse
    {
        [JsonPropertyName("token")]
        public string? Token { get; set; }

        [JsonPropertyName("message")]
        public string? Message { get; set; }
    }

    private async Task HandleLogin()
    {
        isLoggingIn = true;
        apiErrorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/account/login", loginModel);
            var jsonString = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                var result = JsonSerializer.Deserialize<LoginResponse>(jsonString);

                if (!string.IsNullOrEmpty(result?.Token))
                {
                    await localStorage.SetItemAsync("authToken", result.Token);
                    ((ApiAuthenticationStateProvider)authStateProvider).MarkUserAsAuthenticated(result.Token);
                    Navigation.NavigateTo("my-resumes");
                }
                else
                {
                    apiErrorMessage = "Login successful but token was missing.";
                }
            }
            else
            {
                apiErrorMessage = $"Login failed: {jsonString}";
            }
        }
        catch (Exception)
        {
            apiErrorMessage = "An error occurred while connecting to the server.";
        }
        finally
        {
            isLoggingIn = false;
        }
    }
}