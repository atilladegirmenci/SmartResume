@page "/"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Home - SmartCV</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="splash-shell">
            <section class="splash-card splash-content">
                <h1 class="splash-title">You are signed in to <span>SmartCV</span></h1>
                <p class="splash-subtitle mt-3">Continue where you left off or explore the platform.</p>
                <div class="cta-row mt-4">
                    <a href="my-resumes" class="cta-btn cta-btn-primary">Go to My Resumes</a>
                </div>
            </section>
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="splash-shell">
            <div class="bg-orb orb-1"></div>
            <div class="bg-orb orb-2"></div>
            <div class="bg-orb orb-3"></div>

            <section class="splash-card splash-content">
                <h1 class="splash-title">
                    Build a smarter career path with
                    <span>SmartCV</span>
                </h1>
                <p class="splash-subtitle mt-3">
                    Upload your CV, get instant AI analysis, and discover matching job opportunities in seconds.
                </p>

                <div class="cta-row mt-4">
                    <a href="login" class="cta-btn cta-btn-primary">Explore Job Opportunities</a>
                </div>

                <p class="trust-note mt-4 mb-0">Fast. Focused. Built for your next opportunity.</p>
            </section>
        </div>
    </NotAuthorized>
</AuthorizeView>
