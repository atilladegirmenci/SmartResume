@page "/my-resumes"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using SmartResume.Client.Models.Resume;
@using System.Net.Http.Headers;
@using Blazored.LocalStorage;
@using System.Globalization;

@inject HttpClient Http
@inject ILocalStorageService localStorage
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>My Resumes</PageTitle>

<div class="container-fluid m-0 p-0"> 
    <div class="row g-3 m-0">

        @* --- LEFT COLUMN: LIST OF RESUMES --- *@
        <div class="col-xxl-2 col-xl-2 col-lg-3 col-md-4 mb-4 ps-0">
            <div class="card shadow-sm border-0 bg-light rounded-start-0 same-height-panel" 
                 style="position: sticky; top: 1.5rem; display: flex; flex-direction: column;">
                
                @* --- LIST HEADER --- *@
                <div class="card-header bg-transparent border-0 d-flex align-items-center justify-content-between p-3">
                    <h5 class="fw-bold text-secondary mb-0">
                        <i class="bi bi-collection-fill me-2"></i>CV Library
                    </h5>
                    <span class="badge bg-white text-dark shadow-sm rounded-pill border">@resumes.Count</span>
                </div>

                @* --- LIST BODY --- *@
                <div class="card-body p-2 overflow-auto custom-scrollbar">
                    @if (isLoading)
                    {
                        <div class="text-center text-muted py-3">
                            <div class="spinner-border spinner-border-sm mb-2"></div>
                            <p class="small mb-0">Loading...</p>
                        </div>
                    }
                    else if (resumes == null || resumes.Count == 0)
                    {
                        <div class="text-center text-muted py-4 opacity-50">
                            <i class="bi bi-inbox display-6"></i>
                            <p class="mt-2 small mb-0">List is empty.</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-grid gap-2 pe-1">
                            @foreach (var resume in resumes)
                            {
                                bool isActive = selectedResume?.ResumeID == resume.ResumeID;
                                
                                <button type="button"
                                        class="btn text-start p-3 rounded-3 border-0 position-relative @(isActive ? "bg-white shadow-sm border-start border-primary border-4" : "bg-white hover-shadow")"
                                        style="transition: all 0.2s;"
                                        @onclick="() => SelectResume(resume)">

                                    @if (resume.IsAnalyzed)
                                    {
                                        <span class="position-absolute top-0 end-0 mt-2 me-2 text-success fw-bold" title="Analyzed">✔</span>
                                    }
                                    
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <h6 class="mb-0 text-truncate fw-semibold text-dark" style="max-width: 90%;">
                                            @resume.OriginalFileName
                                        </h6>
                                    </div>
                                    
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">
                                        <i class="bi bi-clock me-1"></i>@resume.UploadedAt.ToShortDateString()
                                    </small>
                                </button>
                            }
                        </div>
                    }
                </div>

                @* --- LIST FOOTER: UPLOAD BUTTON --- *@
                <div class="card-footer bg-transparent border-0 p-3">
                    <a href="upload-resume" class="btn btn-dark w-100 rounded-pill shadow-sm">
                        <i class="bi bi-plus-lg me-2"></i> New Upload
                    </a>
                </div>
            </div>
        </div>

        @* --- MIDDLE COLUMN: PDF PREVIEW & ACTIONS --- *@
        <div class="@(activeRightPanel == RightPanelView.None ? "col-xxl-10 col-xl-10 col-lg-9 col-md-8" : "col-xxl-5 col-xl-5 col-lg-4 col-md-8") transition-width mb-4">
            @if (selectedResume != null)
            {
                <div class="card shadow-sm h-100 border-0 bg-transparent same-height-panel">
                    <div class="card-header bg-white shadow-sm rounded mb-3 d-flex justify-content-between align-items-center">
                        <h4 class="mb-0 text-dark">@selectedResume.UserGivenTitle</h4>
                        <small class="text-muted">
                            <i class="bi bi-calendar3 me-1"></i> Uploaded: @selectedResume.UploadedAt.ToString("g")
                        </small>
                    </div>
                    
                    <div class="card-body p-0 d-flex flex-column">
                        
                        @* --- ACTION BUTTONS --- *@
                        <div class="d-flex flex-wrap justify-content-center align-items-center mb-3 gap-3">
                            <div class="btn-group shadow-sm">
                                <button class="btn btn-primary" @onclick="DownloadPdf">
                                    <i class="bi bi-download me-1"></i> Download
                                </button>

                                <button class="btn btn-warning text-white" @onclick="AnalyzeResume" disabled="@isAnalyzing">
                                    @if (isAnalyzing)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                        <span> Analyzing...</span>
                                    }
                                    else
                                    {
                                        @if (selectedResume?.IsAnalyzed == true)
                                        {
                                            <i class="bi bi-arrow-repeat me-1"></i> <span> Reanalyze with AI</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-magic me-1"></i> <span> Analyze with AI</span>
                                        }
                                    }
                                </button>

                                <button class="btn btn-danger" @onclick="DeleteResume">
                                    <i class="bi bi-trash me-1"></i> Delete
                                </button>
                            </div>

                            @* --- GET JOBS BUTTON --- *@
                            <button class="btn btn-success shadow-sm" 
                                    @onclick="GetJobRecommendations" 
                                    disabled="@(isGettingJobs || !selectedResume.IsAnalyzed)">
                                @if (isGettingJobs)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Loading Jobs...</span>
                                }
                                else
                                {
                                    <i class="bi bi-briefcase-fill me-1"></i>
                                    <span>Get Jobs</span>
                                }
                            </button>

                            @if (!selectedResume.IsAnalyzed)
                            {
                                <small class="text-warning fw-semibold">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>Analyze and save your CV to unlock job recommendations!
                                </small>
                            }
                        </div>

                        @* --- ERROR MESSAGES --- *@
                        @if (analysisError != null)
                        {
                            <div class="alert alert-danger mb-3 shadow-sm">@analysisError</div>
                        }
                        @if (jobError != null)
                        {
                            <div class="alert alert-warning mb-3 shadow-sm">
                                <i class="bi bi-exclamation-triangle me-2"></i>@jobError
                            </div>
                        }

                        @* --- PDF PREVIEW AREA (Fixed Width for A4 ratio) --- *@
                        <div class="flex-grow-1 w-100 d-flex justify-content-center">
                            <div class="bg-light shadow-sm rounded border" 
                                 style="width: 100%; max-width: 850px; height: 100%; min-height: 0; overflow: hidden;">
                                @if (!string.IsNullOrEmpty(pdfBlobUrl))
                                {
                                    <iframe src="@pdfBlobUrl" style="width:100%; height:100%; min-height: 0; border:none;"></iframe>
                                }
                                else
                                {
                                    <div class="d-flex flex-column justify-content-center align-items-center h-100 text-muted" style="min-height: 0;">
                                        <div class="spinner-border mb-3" style="width: 3rem; height: 3rem;"></div>
                                        <h5>Loading PDF Preview...</h5>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                @* --- NO SELECTION STATE --- *@
                <div class="alert alert-secondary text-center mt-5 shadow-sm">
                    <h5><i class="bi bi-arrow-left me-2"></i>Select a CV from the left panel to view details.</h5>
                </div>
            }
        </div>

        @* --- RIGHT COLUMN: DYNAMIC PANEL (ANALYSIS OR JOBS) --- *@
        @if (activeRightPanel != RightPanelView.None && selectedResume != null)
        {
            <div class="col-xxl-5 col-xl-5 col-lg-5 col-md-12 mb-4 transition-width">
                
                @* --- ANALYSIS PANEL --- *@
                @if (activeRightPanel == RightPanelView.Analysis && analysisResult != null)
                {
                    <div class="card shadow border-0 h-100">
                        <div class="card-header bg-warning text-white d-flex justify-content-between align-items-center py-3">
                            <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Edit Analysis</h5>
                            <button type="button" class="btn-close btn-close-white" @onclick="CloseRightPanel"></button>
                        </div>
                        <div class="card-body overflow-auto custom-scrollbar" style="max-height: 78vh;">
                            
                            <h6 class="text-secondary border-bottom pb-2 fw-bold">Personal Information</h6>
                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label class="form-label text-muted small mb-1">First Name</label>
                                    <input type="text" class="form-control" @bind-value="analysisResult.FirstName" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small mb-1">Last Name</label>
                                    <input type="text" class="form-control" @bind-value="analysisResult.LastName" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small mb-1">Email</label>
                                    <input type="text" class="form-control" @bind-value="analysisResult.ContactDetails.Email" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small mb-1">Phone</label>
                                    <input type="text" class="form-control" @bind-value="analysisResult.ContactDetails.Phone" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small mb-1">Country</label>
                                    <input type="text" class="form-control" @bind-value="analysisResult.ContactDetails.Country" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small mb-1">City</label>
                                    <input type="text" class="form-control" @bind-value="analysisResult.ContactDetails.City" />
                                </div>
                            </div>

                            <h6 class="text-secondary border-bottom pb-2 mt-2 fw-bold">Summary</h6>
                            <textarea class="form-control mb-4" rows="4" @bind="analysisResult.Summary"></textarea>

                            <h6 class="text-secondary border-bottom pb-2 fw-bold">Skills</h6>
                            <textarea class="form-control mb-4" rows="3" @bind="editableSkills"></textarea>

                            <h6 class="text-secondary border-bottom pb-2 fw-bold">Languages</h6>
                            <textarea class="form-control mb-4" rows="2" @bind="editableLanguages"></textarea>

                            <h6 class="text-secondary border-bottom pb-2 fw-bold">Experience</h6>
                            @if (analysisResult.Experience != null)
                            {
                                for (int i = 0; i < analysisResult.Experience.Count; i++)
                                {
                                    <div class="card mb-3 bg-light border">
                                        <div class="card-body p-3">
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label class="small text-muted mb-1">Company</label>
                                                    <input type="text" class="form-control" @bind-value="analysisResult.Experience[i].Company" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="small text-muted mb-1">Title</label>
                                                    <input type="text" class="form-control" @bind-value="analysisResult.Experience[i].Title" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }

                            <h6 class="text-secondary border-bottom pb-2 mt-4 fw-bold">Education</h6>
                            @if (analysisResult.Education != null)
                            {
                                for (int i = 0; i < analysisResult.Education.Count; i++)
                                {
                                    <div class="card mb-3 bg-light border">
                                        <div class="card-body p-3">
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label class="small text-muted mb-1">School</label>
                                                    <input type="text" class="form-control" @bind-value="analysisResult.Education[i].School" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="small text-muted mb-1">Degree</label>
                                                    <input type="text" class="form-control" @bind-value="analysisResult.Education[i].Degree" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        <div class="card-footer bg-white p-3">
                            <button class="btn btn-success btn-lg w-100 fw-bold shadow-sm" disabled="@isSaving" @onclick="SaveResumeData">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span><span>Saving Data...</span>
                                }
                                else
                                {
                                    <i class="bi bi-save me-2"></i> <span>Save All Changes</span>
                                }
                            </button>
                            @if (saveError != null)
                            {
                                <div class="alert alert-danger mt-3 mb-0">@saveError</div>
                            }
                            @if (saveSuccess != null)
                            {
                                <div class="alert alert-success mt-3 mb-0">@saveSuccess</div>
                            }
                        </div>
                    </div>
                }

                @* --- JOBS PANEL --- *@
                @if (activeRightPanel == RightPanelView.Jobs)
                {
                    <div class="card shadow border-0 h-100">
                        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center py-3">
                            <h5 class="mb-0 fw-bold">
                                <i class="bi bi-briefcase-fill me-2"></i>Job Matches (@jobRecommendations.Count)
                            </h5>
                            <button type="button" class="btn-close btn-close-white" @onclick="CloseRightPanel"></button>
                        </div>
                        <div class="card-body p-3 overflow-auto custom-scrollbar" style="max-height: 78vh;">
                            @if (jobRecommendations.Count == 0 && !isGettingJobs)
                            {
                                <div class="text-center text-muted p-5">
                                    <i class="bi bi-search display-1 text-light"></i>
                                    <h5 class="mt-3">No jobs found or fetch failed.</h5>
                                    <p>Try analyzing your CV again or check the API connection.</p>
                                </div>
                            }
                            else
                            {
                                <div class="d-grid gap-3">
                                    @foreach (var job in jobRecommendations)
                                    {
                                        <div class="card border border-light shadow-sm">
                                            <div class="card-body p-3">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <h6 class="card-title fw-bold text-dark mb-0 pe-2">@job.Title</h6>
                                                    @if (!string.IsNullOrWhiteSpace(job.Link))
                                                    {
                                                        <a class="btn btn-sm btn-outline-primary px-3 rounded-pill" href="@job.Link" target="_blank" rel="noopener">Apply</a>
                                                    }
                                                </div>
                                                <div class="text-muted small mb-2">
                                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>@job.Location
                                                    @if (!string.IsNullOrWhiteSpace(job.Source))
                                                    {
                                                        <span class="ms-3"><i class="bi bi-building-fill text-secondary me-1"></i>@job.Source</span>
                                                    }
                                                </div>
                                                
                                                @if (!string.IsNullOrWhiteSpace(job.Snippet))
                                                {
                                                    <div class="card-text small text-secondary bg-light p-2 rounded mt-2 border-start border-3 border-success">
                                                        @((MarkupString)FormatJobSnippet(job.Snippet))
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>

<style>
    /* Smooth transition for layout changes */
    .transition-width {
        transition: width 0.3s ease-in-out, flex 0.3s ease-in-out;
    }

    .same-height-panel {
        height: calc(100vh - 6rem);
    }
</style>

@code {
    // UI State Enum
    private enum RightPanelView { None, Analysis, Jobs }
    private RightPanelView activeRightPanel = RightPanelView.None;

    private List<ResumeResponseModel> resumes = new List<ResumeResponseModel>();
    private ResumeResponseModel? selectedResume;
    private bool isLoading = true;
    
    private ResumeAnalysisModel? analysisResult;
    private bool isAnalyzing = false;
    private string? analysisError;
    
    private bool isSaving = false;
    private string? saveError;
    private string? saveSuccess;
    
    private string editableSkills = "";
    private string editableLanguages = "";
    private string? pdfBlobUrl;
    
    private bool isGettingJobs = false;
    private string? jobError;
    private List<JobListingModel> jobRecommendations = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadResumes();
    }

    private async Task LoadResumes()
    {
        isLoading = true;
        try
        {
            var token = await localStorage.GetItemAsync<string>("authToken");
            if (!string.IsNullOrEmpty(token))
            {
                Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }
            resumes = await Http.GetFromJsonAsync<List<ResumeResponseModel>>("api/resume") ?? new List<ResumeResponseModel>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading resumes: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectResume(ResumeResponseModel resume)
    {
        selectedResume = resume;
        
        // Reset states
        analysisResult = null;
        analysisError = null;
        jobError = null;
        jobRecommendations.Clear();
        saveSuccess = null;
        saveError = null;
        
        // Close right panel when changing resumes
        activeRightPanel = RightPanelView.None;

        await LoadPdfPreview(resume.ResumeID);

        if (resume.IsAnalyzed)
        {
            await GetJobRecommendations();
        }
    }

    private void CloseRightPanel()
    {
        activeRightPanel = RightPanelView.None;
    }

    private async Task LoadPdfPreview(int resumeId)
    {
        // Clear previous URL if exists to prevent memory leaks
        if (!string.IsNullOrEmpty(pdfBlobUrl))
        {
            await JS.InvokeVoidAsync("revokeUrl", pdfBlobUrl);
            pdfBlobUrl = null;
        }

        try
        {
            // Fetch stream with authorized client
            var stream = await Http.GetStreamAsync($"api/resume/{resumeId}/download");
            using var streamRef = new DotNetStreamReference(stream);
            
            // Invoke JS to generate Blob URL
            pdfBlobUrl = await JS.InvokeAsync<string>("createPdfUrl", streamRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"PDF Preview Error: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!string.IsNullOrEmpty(pdfBlobUrl))
        {
            await JS.InvokeVoidAsync("revokeUrl", pdfBlobUrl);
        }
    }

    private async Task DeleteResume()
    {
        if (selectedResume == null) return;
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete '{selectedResume.OriginalFileName}'?");
        if (!confirmed) return;

        try
        {
            var response = await Http.DeleteAsync($"api/resume/{selectedResume.ResumeID}");
            if (response.IsSuccessStatusCode)
            {
                await LoadResumes();
                selectedResume = null;
                activeRightPanel = RightPanelView.None;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting: {ex.Message}");
        }
    }

    private async Task DownloadPdf()
    {
        if (selectedResume == null) return;
        try
        {
            var fileBytes = await Http.GetByteArrayAsync($"api/resume/{selectedResume.ResumeID}/download");
            var fileName = selectedResume.OriginalFileName;
            using var stream = new MemoryStream(fileBytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Download error: {ex.Message}");
        }
    }

    private async Task AnalyzeResume()
    {
        if (selectedResume == null) return;

        isAnalyzing = true;
        analysisResult = null;
        analysisError = null;

        try
        {
            var response = await Http.PostAsync($"api/resume/analyze/{selectedResume.ResumeID}", null);

            if (response.IsSuccessStatusCode)
            {
                analysisResult = await response.Content.ReadFromJsonAsync<ResumeAnalysisModel>();

                // Open panel only after analysis result arrives
                activeRightPanel = RightPanelView.Analysis;

                if (analysisResult != null)
                {
                    editableSkills = string.Join(", ", analysisResult.Skills ?? new List<string>());
                    editableLanguages = string.Join(", ", analysisResult.Languages ?? new List<string>());
                }
            }
            else
            {
                var errorMsg = await response.Content.ReadAsStringAsync();
                analysisError = $"Analysis failed: {errorMsg}";
            }
        }
        catch (Exception ex)
        {
            analysisError = $"Error: {ex.Message}";
        }
        finally
        {
            isAnalyzing = false;
        }
    }

    private async Task SaveResumeData()
    {
        if (selectedResume == null || analysisResult == null) return;

        isSaving = true;
        saveError = null;
        saveSuccess = null;

        try
        {
            var finalSkills = editableSkills.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
                                            .Select(s => s.Trim()).ToList();

            var finalLangs = editableLanguages.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
                                              .Select(s => s.Trim()).ToList();

            var request = new SaveResumeAnalysisRequest
            {
                Skills = finalSkills,
                Education = analysisResult.Education.Select(e => new SaveEducationDto
                {
                    InstitutionName = e.School,
                    Degree = e.Degree,
                    StartDate = ParseDateOrNull(e.StartDate),
                    EndDate = ParseDateOrNull(e.EndDate)
                }).ToList(),

                Experience = analysisResult.Experience.Select(e => new SaveExperianceDto
                {
                    CompanyName = e.Company,
                    PositionTitle = e.Title,
                    Description = "",
                    StartDate = ParseDateOrNull(e.StartDate),
                    EndDate = ParseDateOrNull(e.EndDate)
                }).ToList(),

                ContactDetails = new SaveContactDetailsDto()
                {
                    Email = analysisResult.ContactDetails.Email,
                    Phone = analysisResult.ContactDetails.Phone,
                    City = analysisResult.ContactDetails.City,
                    Country = analysisResult.ContactDetails.Country
                }
            };

            var response = await Http.PostAsJsonAsync($"api/resume/{selectedResume.ResumeID}/analysis", request);

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                saveError = $"Save failed: {error}";
                return;
            }

            MarkSelectedResumeAsAnalyzed();
            saveSuccess = "Resume analysis saved successfully.";
            
            // Auto-close the right panel upon successful save
            activeRightPanel = RightPanelView.None;
        }
        catch (Exception ex)
        {
            saveError = $"Error while saving: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private static DateTime? ParseDateOrNull(string? date)
    {
        if (string.IsNullOrWhiteSpace(date)) return null;

        if (DateTime.TryParseExact(date, "dd.MM.yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedDate))
        {
            return parsedDate;
        }
        return null;
    }

    private void MarkSelectedResumeAsAnalyzed()
    {
        if (selectedResume == null) return;

        selectedResume.IsAnalyzed = true;
        var resumeInList = resumes.FirstOrDefault(r => r.ResumeID == selectedResume.ResumeID);
        if (resumeInList != null)
        {
            resumeInList.IsAnalyzed = true;
        }

        StateHasChanged();
    }

    private async Task GetJobRecommendations()
    {
        if (selectedResume == null) return;

        isGettingJobs = true;
        jobError = null;
        
        // Open the right panel and set it to Jobs View
        activeRightPanel = RightPanelView.Jobs;

        try
        {
            var response = await Http.GetAsync($"api/resume/{selectedResume.ResumeID}/job-recommendations");

            if (response.IsSuccessStatusCode)
            {
                jobRecommendations = await response.Content.ReadFromJsonAsync<List<JobListingModel>>() ?? new List<JobListingModel>();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                jobError = error;
                jobRecommendations.Clear();
            }
        }
        catch (Exception ex)
        {
            jobError = $"Error calling job service: {ex.Message}";
            jobRecommendations.Clear();
        }
        finally
        {
            isGettingJobs = false;
        }
    }

    private string FormatJobSnippet(string snippet)
    {
        if (string.IsNullOrWhiteSpace(snippet)) return string.Empty;

        var cleaned = snippet.Replace("&nbsp;", " ");
        cleaned = System.Text.RegularExpressions.Regex.Replace(cleaned, @"[ ]{2,}", " ");
        cleaned = System.Text.RegularExpressions.Regex.Replace(cleaned, @"(?:\s*\.\.\.\s*)+", " ... ");
        cleaned = cleaned.Replace("●", "<br />&bull; ").Replace("•", "<br />&bull; ");

        return cleaned.Trim();
    }
}