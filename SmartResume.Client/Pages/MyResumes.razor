@code {
    // UI State Enum
    private enum RightPanelView { None, Analysis, Jobs }
    private RightPanelView activeRightPanel = RightPanelView.None;

    private List<ResumeResponseModel> resumes = new List<ResumeResponseModel>();
    private ResumeResponseModel? selectedResume;
    private bool isLoading = true;
    
    private ResumeAnalysisModel? analysisResult;
    private bool isAnalyzing = false;
    private string? analysisError;
    
    private bool isSaving = false;
    private string? saveError;
    private string? saveSuccess;
    
    private List<string> editableSkillList = new();
    private HashSet<string> selectedSkillsForSearch = new(StringComparer.OrdinalIgnoreCase);
    private string newSkillText = "";
    private int? editingSkillIndex;
    private string editingSkillText = "";
    private bool isEditingTitle = false;
    private bool isUpdatingTitle = false;
    private string editableTitle = string.Empty;
    private string? titleError;
    private string? pdfBlobUrl;
    
    private bool isGettingJobs = false;
    private bool isLoadingSavedAnalysis = false;
    private string? jobError;
    private List<JobListingModel> jobRecommendations = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadResumes();
    }

    private async Task LoadResumes()
    {
        isLoading = true;
        try
        {
            var token = await localStorage.GetItemAsync<string>("authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                resumes = new List<ResumeResponseModel>();
                Navigation.NavigateTo("/login", forceLoad: false);
                return;
            }

            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.GetAsync("api/resume");
            if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                await localStorage.RemoveItemAsync("authToken");
                Http.DefaultRequestHeaders.Authorization = null;
                resumes = new List<ResumeResponseModel>();
                Navigation.NavigateTo("/login", forceLoad: false);
                return;
            }

            response.EnsureSuccessStatusCode();
            resumes = await response.Content.ReadFromJsonAsync<List<ResumeResponseModel>>() ?? new List<ResumeResponseModel>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading resumes: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadSavedAnalysisResult()
    {
        if (selectedResume == null || !selectedResume.IsAnalyzed)
            return;

        isLoadingSavedAnalysis = true;
        analysisError = null;

        try
        {
            var response = await Http.GetAsync($"api/resume/{selectedResume.ResumeID}/analysis-result");

            if (response.IsSuccessStatusCode)
            {
                analysisResult = await response.Content.ReadFromJsonAsync<ResumeAnalysisModel>();
                if (analysisResult != null)
                {
                    editableSkillList = (analysisResult.Skills ?? new List<string>())
                        .Where(s => !string.IsNullOrWhiteSpace(s))
                        .Select(s => s.Trim())
                        .ToList();

                    selectedSkillsForSearch = (analysisResult.SelectedSkills ?? new List<string>())
                        .Where(s => !string.IsNullOrWhiteSpace(s))
                        .Select(s => s.Trim())
                        .ToHashSet(StringComparer.OrdinalIgnoreCase);

                    if (selectedSkillsForSearch.Count == 0)
                    {
                        foreach (var skill in editableSkillList.Take(3))
                        {
                            selectedSkillsForSearch.Add(skill);
                        }
                    }

                    activeRightPanel = RightPanelView.Analysis;
                }
            }
            else
            {
                var errorMsg = await response.Content.ReadAsStringAsync();
                analysisError = $"Could not load saved analysis: {errorMsg}";
            }
        }
        catch (Exception ex)
        {
            analysisError = $"Error while loading saved analysis: {ex.Message}";
        }
        finally
        {
            isLoadingSavedAnalysis = false;
        }
    }

    private async Task SelectResume(ResumeResponseModel resume)
    {
        selectedResume = resume;
        editableTitle = FormatResumeTitle(resume.UserGivenTitle);
        isEditingTitle = false;
        titleError = null;
        
        // Reset states
        analysisResult = null;
        analysisError = null;
        jobError = null;
        jobRecommendations.Clear();
        selectedSkillsForSearch.Clear();
        saveSuccess = null;
        saveError = null;
        
        // Close right panel when changing resumes
        activeRightPanel = RightPanelView.None;

        await LoadPdfPreview(resume.ResumeID);

        if (resume.IsAnalyzed)
        {
            await GetJobRecommendations();
        }
    }

    private void CloseRightPanel()
    {
        activeRightPanel = RightPanelView.None;
    }

    private void StartEditTitle()
    {
        if (selectedResume == null) return;
        editableTitle = FormatResumeTitle(selectedResume.UserGivenTitle);
        titleError = null;
        isEditingTitle = true;
    }

    private void CancelEditTitle()
    {
        if (selectedResume != null)
        {
            editableTitle = FormatResumeTitle(selectedResume.UserGivenTitle);
        }
        titleError = null;
        isEditingTitle = false;
    }

    private async Task SaveResumeTitle()
    {
        if (selectedResume == null) return;

        isUpdatingTitle = true;
        titleError = null;

        try
        {
            var response = await Http.PutAsJsonAsync($"api/resume/{selectedResume.ResumeID}/title", new { UserGivenTitle = editableTitle });
            if (!response.IsSuccessStatusCode)
            {
                titleError = await response.Content.ReadAsStringAsync();
                return;
            }

            var newTitle = (editableTitle ?? string.Empty).Trim();
            selectedResume.UserGivenTitle = newTitle;
            var resumeInList = resumes.FirstOrDefault(r => r.ResumeID == selectedResume.ResumeID);
            if (resumeInList != null)
            {
                resumeInList.UserGivenTitle = newTitle;
            }

            isEditingTitle = false;
        }
        catch (Exception ex)
        {
            titleError = $"Could not update title: {ex.Message}";
        }
        finally
        {
            isUpdatingTitle = false;
        }
    }

    private async Task LoadPdfPreview(int resumeId)
    {
        // Clear previous URL if exists to prevent memory leaks
        if (!string.IsNullOrEmpty(pdfBlobUrl))
        {
            await JS.InvokeVoidAsync("revokeUrl", pdfBlobUrl);
            pdfBlobUrl = null;
        }

        try
        {
            // Fetch stream with authorized client
            var stream = await Http.GetStreamAsync($"api/resume/{resumeId}/download");
            using var streamRef = new DotNetStreamReference(stream);
            
            // Invoke JS to generate Blob URL
            pdfBlobUrl = await JS.InvokeAsync<string>("createPdfUrl", streamRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"PDF Preview Error: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!string.IsNullOrEmpty(pdfBlobUrl))
        {
            await JS.InvokeVoidAsync("revokeUrl", pdfBlobUrl);
        }
    }

    private async Task DeleteResume()
    {
        if (selectedResume == null) return;
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete '{selectedResume.OriginalFileName}'?");
        if (!confirmed) return;

        try
        {
            var response = await Http.DeleteAsync($"api/resume/{selectedResume.ResumeID}");
            if (response.IsSuccessStatusCode)
            {
                await LoadResumes();
                selectedResume = null;
                activeRightPanel = RightPanelView.None;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting: {ex.Message}");
        }
    }

    private async Task DownloadPdf()
    {
        if (selectedResume == null) return;
        try
        {
            var fileBytes = await Http.GetByteArrayAsync($"api/resume/{selectedResume.ResumeID}/download");
            var fileName = selectedResume.OriginalFileName;
            using var stream = new MemoryStream(fileBytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Download error: {ex.Message}");
        }
    }

    private async Task AnalyzeResume()
    {
        if (selectedResume == null) return;

        isAnalyzing = true;
        analysisResult = null;
        analysisError = null;

        try
        {
            var response = await Http.PostAsync($"api/resume/analyze/{selectedResume.ResumeID}", null);

            if (response.IsSuccessStatusCode)
            {
                analysisResult = await response.Content.ReadFromJsonAsync<ResumeAnalysisModel>();

                // Open panel only after analysis result arrives
                activeRightPanel = RightPanelView.Analysis;

                if (analysisResult != null)
                {
                    editableSkillList = (analysisResult.Skills ?? new List<string>())
                        .Where(s => !string.IsNullOrWhiteSpace(s))
                        .Select(s => s.Trim())
                        .ToList();

                    selectedSkillsForSearch = editableSkillList
                        .Take(3)
                        .ToHashSet(StringComparer.OrdinalIgnoreCase);

                }
            }
            else
            {
                var errorMsg = await response.Content.ReadAsStringAsync();
                analysisError = $"Analysis failed: {errorMsg}";
            }
        }
        catch (Exception ex)
        {
            analysisError = $"Error: {ex.Message}";
        }
        finally
        {
            isAnalyzing = false;
        }
    }

    private async Task SaveResumeData()
    {
        if (selectedResume == null || analysisResult == null) return;

        isSaving = true;
        saveError = null;
        saveSuccess = null;

        try
        {
            var finalSkills = editableSkillList
                                .Where(s => !string.IsNullOrWhiteSpace(s))
                                .Select(s => s.Trim())
                                .Distinct(StringComparer.OrdinalIgnoreCase)
                                .ToList();

            var request = new SaveResumeAnalysisRequest
            {
                Skills = finalSkills,
                SelectedSkills = finalSkills.Where(s => selectedSkillsForSearch.Contains(s)).ToList(),
                Education = analysisResult.Education.Select(e => new SaveEducationDto
                {
                    InstitutionName = e.School,
                    Degree = e.Degree,
                    StartDate = ParseDateOrNull(e.StartDate),
                    EndDate = ParseDateOrNull(e.EndDate)
                }).ToList(),

                Experience = analysisResult.Experience.Select(e => new SaveExperianceDto
                {
                    CompanyName = e.Company,
                    PositionTitle = e.Title,
                    Description = "",
                    StartDate = ParseDateOrNull(e.StartDate),
                    EndDate = ParseDateOrNull(e.EndDate)
                }).ToList(),

                ContactDetails = new SaveContactDetailsDto()
                {
                    Email = analysisResult.ContactDetails.Email,
                    Phone = analysisResult.ContactDetails.Phone,
                    City = analysisResult.ContactDetails.City,
                    Country = analysisResult.ContactDetails.Country
                }
            };

            var response = await Http.PostAsJsonAsync($"api/resume/{selectedResume.ResumeID}/analysis", request);

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                saveError = $"Save failed: {error}";
                return;
            }

            MarkSelectedResumeAsAnalyzed();
            saveSuccess = "Resume analysis saved successfully.";
            
            // Auto-close the right panel upon successful save
            activeRightPanel = RightPanelView.None;
        }
        catch (Exception ex)
        {
            saveError = $"Error while saving: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private static DateTime? ParseDateOrNull(string? date)
    {
        if (string.IsNullOrWhiteSpace(date)) return null;

        if (DateTime.TryParseExact(date, "dd.MM.yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedDate))
        {
            return parsedDate;
        }
        return null;
    }

    private void MarkSelectedResumeAsAnalyzed()
    {
        if (selectedResume == null) return;

        selectedResume.IsAnalyzed = true;
        var resumeInList = resumes.FirstOrDefault(r => r.ResumeID == selectedResume.ResumeID);
        if (resumeInList != null)
        {
            resumeInList.IsAnalyzed = true;
        }

        StateHasChanged();
    }

    private async Task GetJobRecommendations()
    {
        if (selectedResume == null) return;

        isGettingJobs = true;
        jobError = null;
        
        // Open the right panel and set it to Jobs View
        activeRightPanel = RightPanelView.Jobs;

        try
        {
            var response = await Http.GetAsync($"api/resume/{selectedResume.ResumeID}/job-recommendations");

            if (response.IsSuccessStatusCode)
            {
                jobRecommendations = await response.Content.ReadFromJsonAsync<List<JobListingModel>>() ?? new List<JobListingModel>();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                jobError = error;
                jobRecommendations.Clear();
            }
        }
        catch (Exception ex)
        {
            jobError = $"Error calling job service: {ex.Message}";
            jobRecommendations.Clear();
        }
        finally
        {
            isGettingJobs = false;
        }
    }

    private string FormatJobSnippet(string snippet)
    {
        if (string.IsNullOrWhiteSpace(snippet)) return string.Empty;

        var cleaned = snippet.Replace("&nbsp;", " ");
        cleaned = System.Text.RegularExpressions.Regex.Replace(cleaned, @"[ ]{2,}", " ");
        cleaned = System.Text.RegularExpressions.Regex.Replace(cleaned, @"(?:\s*\.\.\.\s*)+", " ... ");
        cleaned = cleaned.Replace("●", "<br />&bull; ").Replace("•", "<br />&bull; ");

        return cleaned.Trim();
    }

    private void AddSkill()
    {
        var skill = (newSkillText ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(skill))
            return;

        editableSkillList.Add(skill);
        selectedSkillsForSearch.Add(skill);
        newSkillText = string.Empty;
        editingSkillIndex = null;
        editingSkillText = string.Empty;
    }

    private void RemoveSkillAt(int index)
    {
        if (index < 0 || index >= editableSkillList.Count)
            return;

        var removedSkill = editableSkillList[index];
        editableSkillList.RemoveAt(index);
        selectedSkillsForSearch.RemoveWhere(s => string.Equals(s, removedSkill, StringComparison.OrdinalIgnoreCase));

        if (editingSkillIndex == index)
        {
            editingSkillIndex = null;
            editingSkillText = string.Empty;
        }
        else if (editingSkillIndex.HasValue && editingSkillIndex.Value > index)
        {
            editingSkillIndex--;
        }
    }

    private void StartEditSkill(int index)
    {
        if (index < 0 || index >= editableSkillList.Count)
            return;

        editingSkillIndex = index;
        editingSkillText = editableSkillList[index];
    }

    private void SaveEditSkill()
    {
        if (!editingSkillIndex.HasValue)
            return;

        var oldSkill = editableSkillList[editingSkillIndex.Value];
        var updated = (editingSkillText ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(updated))
            return;

        editableSkillList[editingSkillIndex.Value] = updated;
        if (selectedSkillsForSearch.Remove(oldSkill))
        {
            selectedSkillsForSearch.Add(updated);
        }
        editingSkillIndex = null;
        editingSkillText = string.Empty;
    }

    private void CancelEditSkill()
    {
        editingSkillIndex = null;
        editingSkillText = string.Empty;
    }

    private void ToggleSkillSelection(string skill)
    {
        if (selectedSkillsForSearch.Contains(skill))
            selectedSkillsForSearch.Remove(skill);
        else
            selectedSkillsForSearch.Add(skill);
    }

    private static string FormatResumeTitle(string? title)
    {
        if (string.IsNullOrWhiteSpace(title))
            return string.Empty;

        return title.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase)
            ? title[..^4]
            : title;
    }
}