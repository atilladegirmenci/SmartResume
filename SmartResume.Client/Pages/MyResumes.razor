@page "/my-resumes"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IAsyncDisposable

@using SmartResume.Client.Models.Resume;
@using System.Net.Http.Headers;
@using Blazored.LocalStorage;
@using System.Globalization;

@inject HttpClient Http
@inject ILocalStorageService localStorage
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>My Resumes</PageTitle>

<div class="container-fluid m-0 p-0"> 
    <div class="row g-3 m-0">

        @* --- LEFT COLUMN: LIST OF RESUMES --- *@
        <ResumeListPanel
            Resumes="resumes"
            IsLoading="isLoading"
            SelectedResumeId="selectedResume?.ResumeID"
            OnSelectResume="SelectResume" />

        @* --- MIDDLE COLUMN: PDF PREVIEW & ACTIONS --- *@
        <div class="@(activeRightPanel == RightPanelView.None ? "col-xxl-10 col-xl-10 col-lg-9 col-md-8" : "col-xxl-5 col-xl-5 col-lg-4 col-md-8") transition-width mb-4 resume-main-column">
            @if (selectedResume != null)
            {
                <div class="card shadow-sm h-100 border-0 same-height-panel resume-main-card">
                    <div class="card-header rounded mb-3 d-flex justify-content-between align-items-center resume-main-header">
                        <div class="d-flex align-items-center gap-2 flex-grow-1">
                            @if (isEditingTitle)
                            {
                                <div class="input-group" style="max-width: 520px;">
                                    <input class="form-control" @bind="editableTitle" />
                                    <button class="btn btn-success" type="button" @onclick="SaveResumeTitle" disabled="@isUpdatingTitle">
                                        @if (isUpdatingTitle)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-check-lg"></i>
                                        }
                                    </button>
                                    <button class="btn btn-outline-secondary" type="button" @onclick="CancelEditTitle" disabled="@isUpdatingTitle">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <h4 class="mb-0 text-dark">@FormatResumeTitle(selectedResume.UserGivenTitle)</h4>
                                <button class="btn btn-sm btn-link text-warning p-0" type="button" title="Edit title" @onclick="StartEditTitle">
                                    <i class="bi bi-pencil-fill"></i>
                                </button>
                            }
                        </div>
                        <small class="text-muted">
                            <i class="bi bi-calendar3 me-1"></i> Uploaded: @selectedResume.UploadedAt.ToString("g")
                        </small>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(titleError))
                    {
                        <div class="alert alert-warning py-2 px-3 mb-3">@titleError</div>
                    }

                    <div class="card-body p-0 d-flex flex-column">

                        @* --- ACTION BUTTONS --- *@
                        <div class="d-flex flex-wrap justify-content-center align-items-center mb-3 gap-3 resume-actions-wrap">
                            <div class="btn-group shadow-sm resume-actions-group">
                                <button class="btn btn-primary" @onclick="DownloadPdf">
                                    <i class="bi bi-download me-1"></i> Download
                                </button>

                                <button class="btn btn-warning text-white" @onclick="AnalyzeResume" disabled="@isAnalyzing">
                                    @if (isAnalyzing)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                        <span> Analyzing...</span>
                                    }
                                    else
                                    {
                                        @if (selectedResume?.IsAnalyzed == true)
                                        {
                                            <i class="bi bi-arrow-repeat me-1"></i> <span> Reanalyze with AI</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-magic me-1"></i> <span> Analyze with AI</span>
                                        }
                                    }
                                </button>

                                <button class="btn btn-danger" @onclick="DeleteResume">
                                    <i class="bi bi-trash me-1"></i> Delete
                                </button>
                            </div>

                            @* --- GET JOBS BUTTON --- *@
                            <button class="btn btn-success shadow-sm resume-action-secondary"
                                    @onclick="GetJobRecommendations"
                                    disabled="@(isGettingJobs || !selectedResume.IsAnalyzed || activeRightPanel == RightPanelView.Analysis || isSaving)">
                                @if (isGettingJobs)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Loading Jobs...</span>
                                }
                                else
                                {
                                    <i class="bi bi-briefcase-fill me-1"></i>
                                    <span>Get Jobs</span>
                                }
                            </button>
                            @* --- EDIT ANALYZE RESULT BUTTON*@
                            <button class="btn btn-outline-secondary shadow-sm resume-action-secondary"
                                    @onclick="LoadSavedAnalysisResult"
                                    disabled="@(isLoadingSavedAnalysis || !selectedResume.IsAnalyzed)">
                                @if (isLoadingSavedAnalysis)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Loading Analysis...</span>
                                }
                                else
                                {
                                    <i class="bi bi-sliders me-1"></i>
                                    <span>Edit Saved Analysis</span>
                                }
                            </button>

                            @if (!selectedResume.IsAnalyzed)
                            {
                                <small class="text-warning fw-semibold resume-hint-text">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>Analyze and save your CV to unlock job recommendations!
                                </small>
                            }
                        </div>

                        @* --- ERROR MESSAGES --- *@
                        @if (analysisError != null)
                        {
                            <div class="alert alert-danger mb-3 shadow-sm resume-inline-alert">@analysisError</div>
                        }
                        @if (jobError != null)
                        {
                            <div class="alert alert-warning mb-3 shadow-sm resume-inline-alert">
                                <i class="bi bi-exclamation-triangle me-2"></i>@jobError
                            </div>
                        }

                        @* --- PDF PREVIEW AREA (Fixed Width for A4 ratio) --- *@
                        <div class="flex-grow-1 w-100 d-flex justify-content-center">
                            <div class="shadow-sm rounded border pdf-preview-frame preview-container resume-pdf-shell @(activeRightPanel == RightPanelView.None ? "pdf-preview-wide" : "pdf-preview-narrow")"
                                 style="height: 100%; min-height: 0; overflow: hidden;">
                                @if (isAnalyzing)
                                {
                                    <div class="analyze-overlay">
                                        <div class="analyze-overlay-text">AI is analyzing your CV...</div>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(pdfBlobUrl))
                                {
                                    <iframe src="@pdfBlobUrl" style="width:100%; height:100%; min-height: 0; border:none;"></iframe>
                                }
                                else
                                {
                                    <div class="d-flex flex-column justify-content-center align-items-center h-100 text-muted resume-pdf-loading" style="min-height: 0;">
                                        <div class="spinner-border mb-3" style="width: 3rem; height: 3rem;"></div>
                                        <h5>Loading PDF Preview...</h5>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                @* --- NO SELECTION STATE --- *@
                <div class="alert alert-secondary text-center mt-5 shadow-sm">
                    <h5><i class="bi bi-arrow-left me-2"></i>Select a CV from the left panel to view details.</h5>
                </div>
            }
        </div>

        @* --- RIGHT COLUMN: DYNAMIC PANEL (ANALYSIS OR JOBS) --- *@
        @if (activeRightPanel != RightPanelView.None && selectedResume != null)
        {
            <RightPanel
                IsAnalysisView="@(activeRightPanel == RightPanelView.Analysis)"
                IsJobsView="@(activeRightPanel == RightPanelView.Jobs)"
                AnalysisResult="analysisResult"
                EditableSkillList="editableSkillList"
                SelectedSkillsForSearch="selectedSkillsForSearch"
                EditingSkillIndex="editingSkillIndex"
                EditingSkillText="editingSkillText"
                EditingSkillTextChanged="OnEditingSkillTextChanged"
                NewSkillText="newSkillText"
                NewSkillTextChanged="OnNewSkillTextChanged"
                IsSaving="isSaving"
                ShowSaveFeedback="hasAttemptedSave"
                SaveError="saveError"
                SaveSuccess="saveSuccess"
                IsGettingJobs="isGettingJobs"
                JobRecommendations="jobRecommendations"
                OnCloseRightPanel="CloseRightPanel"
                OnSaveResumeData="SaveResumeData"
                OnSaveEditSkill="SaveEditSkill"
                OnCancelEditSkill="CancelEditSkill"
                OnStartEditSkill="StartEditSkill"
                OnRemoveSkillAt="RemoveSkillAt"
                OnToggleSkillSelection="ToggleSkillSelection"
                OnAddSkill="AddSkill"
                FormatJobSnippet="FormatJobSnippet" />
        }

    </div>
</div>

<style>
    .resume-main-column {
        padding-left: .35rem;
    }

    .resume-main-card {
        background: linear-gradient(180deg, #f8fbff 0%, #f3f8ff 100%);
        border: 1px solid #e4ebf5 !important;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(30, 52, 84, 0.08) !important;
        padding: .45rem;
    }

    .resume-main-header {
        background: #fff;
        border: 1px solid #e8edf5;
    }

    .resume-actions-wrap {
        background: #fff;
        border: 1px solid #e8edf5;
        border-radius: 12px;
        padding: .85rem;
    }

    .resume-actions-group .btn {
        border: none;
    }

    .resume-actions-group .btn-primary {
        background: #2f6df3;
    }

    .resume-actions-group .btn-warning {
        background: #f2a933;
    }

    .resume-actions-group .btn-danger {
        background: #dc4d59;
    }

    .resume-action-secondary {
        min-width: 165px;
    }

    .resume-hint-text {
        background: #fff8df;
        border: 1px solid #ffe4a8;
        border-radius: 999px;
        padding: .35rem .7rem;
    }

    .resume-inline-alert {
        border-radius: 10px;
    }

    .resume-pdf-shell {
        background: #f2f6fc;
        border-color: #dce5f2 !important;
    }

    .resume-pdf-loading h5 {
        font-size: 1rem;
        font-weight: 600;
    }

    /* Smooth transition for layout changes */
    .transition-width {
        transition: width 0.3s ease-in-out, flex 0.3s ease-in-out;
    }

    .same-height-panel {
        height: calc(100vh - 6rem);
    }

    .pdf-preview-frame {
        width: 100%;
    }

    .pdf-preview-wide {
        max-width: 720px;
    }

    .pdf-preview-narrow {
        max-width: 580px;
    }

    .preview-container {
        position: relative;
    }

    .analyze-overlay {
        position: absolute;
        inset: 0;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(120deg, rgba(255,0,128,.28), rgba(0,180,255,.28), rgba(120,255,0,.28), rgba(255,200,0,.28), rgba(180,0,255,.28));
        background-size: 300% 300%;
        animation: aiGradientFlow 4s ease infinite;
        backdrop-filter: blur(0.5px);
    }

    .analyze-overlay-text {
        color: #fff;
        font-weight: 700;
        letter-spacing: .3px;
        text-shadow: 0 2px 8px rgba(0,0,0,.35);
        background: rgba(0,0,0,.25);
        padding: .6rem 1rem;
        border-radius: 999px;
    }

    @@keyframes aiGradientFlow {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    .skill-pill {
        display: inline-flex;
        align-items: center;
        gap: .25rem;
        border-radius: 999px;
        border: 1px solid #dbe2ea;
        padding: .35rem .45rem .35rem .8rem;
    }

    .skill-pill-main {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        cursor: pointer;
        font-size: 1rem;
    }

    .skill-pill-selected {
        background: #0d6efd;
        color: #fff;
        border-color: #0d6efd;
    }

    .skill-pill-unselected {
        background: #fff;
        color: #212529;
    }

    .skill-action-btn {
        width: 26px;
        height: 26px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid transparent;
        background: transparent;
        transition: all .15s ease-in-out;
        padding: 0;
    }

    .skill-action-edit {
        color: #f4b400;
    }

    .skill-action-edit:hover {
        background: #fff6db;
        border-color: #ffe08a;
    }

    .skill-action-remove {
        color: #dc3545;
    }

    .skill-action-remove:hover {
        background: #ffecef;
        border-color: #ffc2c9;
    }

    .summary-textarea {
        overflow-y: hidden;
        resize: vertical;
    }

    .info-icon {
        color: #212529;
        display: inline-flex;
        align-items: center;
        cursor: help;
    }
</style>

@code {
    // UI State Enum
    private enum RightPanelView { None, Analysis, Jobs }
    private RightPanelView activeRightPanel = RightPanelView.None;

    private List<ResumeResponseModel> resumes = new List<ResumeResponseModel>();
    private ResumeResponseModel? selectedResume;
    private bool isLoading = true;
    
    private ResumeAnalysisModel? analysisResult;
    private bool isAnalyzing = false;
    private string? analysisError;
    
    private bool isSaving = false;
    private bool hasAttemptedSave = false;
    private string? saveError;
    private string? saveSuccess;
    
    private List<string> editableSkillList = new();
    private HashSet<string> selectedSkillsForSearch = new(StringComparer.OrdinalIgnoreCase);
    private string newSkillText = "";
    private int? editingSkillIndex;
    private string editingSkillText = "";
    private bool isEditingTitle = false;
    private bool isUpdatingTitle = false;
    private string editableTitle = string.Empty;
    private string? titleError;
    private string? pdfBlobUrl;
    
    private bool isGettingJobs = false;
    private bool isLoadingSavedAnalysis = false;
    private string? jobError;
    private List<JobListingModel> jobRecommendations = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadResumes();
    }

    private async Task LoadResumes()
    {
        isLoading = true;
        try
        {
            var token = await localStorage.GetItemAsync<string>("authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                resumes = new List<ResumeResponseModel>();
                Navigation.NavigateTo("/login", forceLoad: false);
                return;
            }

            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.GetAsync("api/resume");
            if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                await localStorage.RemoveItemAsync("authToken");
                Http.DefaultRequestHeaders.Authorization = null;
                resumes = new List<ResumeResponseModel>();
                Navigation.NavigateTo("/login", forceLoad: false);
                return;
            }

            response.EnsureSuccessStatusCode();
            resumes = await response.Content.ReadFromJsonAsync<List<ResumeResponseModel>>() ?? new List<ResumeResponseModel>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading resumes: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadSavedAnalysisResult()
    {
        if (selectedResume == null || !selectedResume.IsAnalyzed)
            return;

        isLoadingSavedAnalysis = true;
        analysisError = null;
        hasAttemptedSave = false;
        saveSuccess = null;
        saveError = null;

        try
        {
            var response = await Http.GetAsync($"api/resume/{selectedResume.ResumeID}/analysis-result");

            if (response.IsSuccessStatusCode)
            {
                analysisResult = await response.Content.ReadFromJsonAsync<ResumeAnalysisModel>();
                if (analysisResult != null)
                {
                    editableSkillList = (analysisResult.Skills ?? new List<string>())
                        .Where(s => !string.IsNullOrWhiteSpace(s))
                        .Select(s => s.Trim())
                        .ToList();

                    selectedSkillsForSearch = (analysisResult.SelectedSkills ?? new List<string>())
                        .Where(s => !string.IsNullOrWhiteSpace(s))
                        .Select(s => s.Trim())
                        .ToHashSet(StringComparer.OrdinalIgnoreCase);

                    if (selectedSkillsForSearch.Count == 0)
                    {
                        foreach (var skill in editableSkillList.Take(3))
                        {
                            selectedSkillsForSearch.Add(skill);
                        }
                    }

                    activeRightPanel = RightPanelView.Analysis;
                }
            }
            else
            {
                var errorMsg = await response.Content.ReadAsStringAsync();
                analysisError = $"Could not load saved analysis: {errorMsg}";
            }
        }
        catch (Exception ex)
        {
            analysisError = $"Error while loading saved analysis: {ex.Message}";
        }
        finally
        {
            isLoadingSavedAnalysis = false;
        }
    }

    private async Task SelectResume(ResumeResponseModel resume)
    {
        selectedResume = resume;
        editableTitle = FormatResumeTitle(resume.UserGivenTitle);
        isEditingTitle = false;
        titleError = null;
        
        // Reset states
        analysisResult = null;
        analysisError = null;
        jobError = null;
        jobRecommendations.Clear();
        selectedSkillsForSearch.Clear();
        saveSuccess = null;
        saveError = null;
        hasAttemptedSave = false;
        
        // Close right panel when changing resumes
        activeRightPanel = RightPanelView.None;

        await LoadPdfPreview(resume.ResumeID);

        if (resume.IsAnalyzed)
        {
            await GetJobRecommendations();
        }
    }

    private void CloseRightPanel()
    {
        activeRightPanel = RightPanelView.None;
    }

    private Task OnEditableTitleChanged(string value)
    {
        editableTitle = value;
        return Task.CompletedTask;
    }

    private Task OnEditingSkillTextChanged(string value)
    {
        editingSkillText = value;
        return Task.CompletedTask;
    }

    private Task OnNewSkillTextChanged(string value)
    {
        newSkillText = value;
        return Task.CompletedTask;
    }

    private void StartEditTitle()
    {
        if (selectedResume == null) return;
        editableTitle = FormatResumeTitle(selectedResume.UserGivenTitle);
        titleError = null;
        isEditingTitle = true;
    }

    private void CancelEditTitle()
    {
        if (selectedResume != null)
        {
            editableTitle = FormatResumeTitle(selectedResume.UserGivenTitle);
        }
        titleError = null;
        isEditingTitle = false;
    }

    private async Task SaveResumeTitle()
    {
        if (selectedResume == null) return;

        isUpdatingTitle = true;
        titleError = null;

        try
        {
            var response = await Http.PutAsJsonAsync($"api/resume/{selectedResume.ResumeID}/title", new { UserGivenTitle = editableTitle });
            if (!response.IsSuccessStatusCode)
            {
                titleError = await response.Content.ReadAsStringAsync();
                return;
            }

            var newTitle = (editableTitle ?? string.Empty).Trim();
            selectedResume.UserGivenTitle = newTitle;
            var resumeInList = resumes.FirstOrDefault(r => r.ResumeID == selectedResume.ResumeID);
            if (resumeInList != null)
            {
                resumeInList.UserGivenTitle = newTitle;
            }

            isEditingTitle = false;
        }
        catch (Exception ex)
        {
            titleError = $"Could not update title: {ex.Message}";
        }
        finally
        {
            isUpdatingTitle = false;
        }
    }

    private async Task LoadPdfPreview(int resumeId)
    {
        // Clear previous URL if exists to prevent memory leaks
        if (!string.IsNullOrEmpty(pdfBlobUrl))
        {
            await JS.InvokeVoidAsync("revokeUrl", pdfBlobUrl);
            pdfBlobUrl = null;
        }

        try
        {
            // Fetch stream with authorized client
            var stream = await Http.GetStreamAsync($"api/resume/{resumeId}/download");
            using var streamRef = new DotNetStreamReference(stream);
            
            // Invoke JS to generate Blob URL
            pdfBlobUrl = await JS.InvokeAsync<string>("createPdfUrl", streamRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"PDF Preview Error: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!string.IsNullOrEmpty(pdfBlobUrl))
        {
            await JS.InvokeVoidAsync("revokeUrl", pdfBlobUrl);
        }
    }

    private async Task DeleteResume()
    {
        if (selectedResume == null) return;
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete '{selectedResume.OriginalFileName}'?");
        if (!confirmed) return;

        try
        {
            var response = await Http.DeleteAsync($"api/resume/{selectedResume.ResumeID}");
            if (response.IsSuccessStatusCode)
            {
                await LoadResumes();
                selectedResume = null;
                activeRightPanel = RightPanelView.None;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting: {ex.Message}");
        }
    }

    private async Task DownloadPdf()
    {
        if (selectedResume == null) return;
        try
        {
            var fileBytes = await Http.GetByteArrayAsync($"api/resume/{selectedResume.ResumeID}/download");
            var fileName = selectedResume.OriginalFileName;
            using var stream = new MemoryStream(fileBytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Download error: {ex.Message}");
        }
    }

    private async Task AnalyzeResume()
    {
        if (selectedResume == null) return;

        isAnalyzing = true;
        analysisResult = null;
        analysisError = null;
        hasAttemptedSave = false;
        saveSuccess = null;
        saveError = null;

        try
        {
            var response = await Http.PostAsync($"api/resume/analyze/{selectedResume.ResumeID}", null);

            if (response.IsSuccessStatusCode)
            {
                analysisResult = await response.Content.ReadFromJsonAsync<ResumeAnalysisModel>();

                // Open panel only after analysis result arrives
                activeRightPanel = RightPanelView.Analysis;

                if (analysisResult != null)
                {
                    editableSkillList = (analysisResult.Skills ?? new List<string>())
                        .Where(s => !string.IsNullOrWhiteSpace(s))
                        .Select(s => s.Trim())
                        .ToList();

                    selectedSkillsForSearch = editableSkillList
                        .Take(3)
                        .ToHashSet(StringComparer.OrdinalIgnoreCase);

                }
            }
            else
            {
                var errorMsg = await response.Content.ReadAsStringAsync();
                analysisError = $"Analysis failed: {errorMsg}";
            }
        }
        catch (Exception ex)
        {
            analysisError = $"Error: {ex.Message}";
        }
        finally
        {
            isAnalyzing = false;
        }
    }

    private async Task SaveResumeData()
    {
        if (selectedResume == null || analysisResult == null) return;

        hasAttemptedSave = true;
        isSaving = true;
        saveError = null;
        saveSuccess = null;

        try
        {
            var finalSkills = editableSkillList
                                .Where(s => !string.IsNullOrWhiteSpace(s))
                                .Select(s => s.Trim())
                                .Distinct(StringComparer.OrdinalIgnoreCase)
                                .ToList();

            var request = new SaveResumeAnalysisRequest
            {
                Skills = finalSkills,
                SelectedSkills = finalSkills.Where(s => selectedSkillsForSearch.Contains(s)).ToList(),
                Education = analysisResult.Education.Select(e => new SaveEducationDto
                {
                    InstitutionName = e.School,
                    Degree = e.Degree,
                    StartDate = ParseDateOrNull(e.StartDate),
                    EndDate = ParseDateOrNull(e.EndDate)
                }).ToList(),

                Experience = analysisResult.Experience.Select(e => new SaveExperianceDto
                {
                    CompanyName = e.Company,
                    PositionTitle = e.Title,
                    Description = "",
                    StartDate = ParseDateOrNull(e.StartDate),
                    EndDate = ParseDateOrNull(e.EndDate)
                }).ToList(),

                ContactDetails = new SaveContactDetailsDto()
                {
                    Email = analysisResult.ContactDetails.Email,
                    Phone = analysisResult.ContactDetails.Phone,
                    City = analysisResult.ContactDetails.City,
                    Country = analysisResult.ContactDetails.Country
                }
            };

            var response = await Http.PostAsJsonAsync($"api/resume/{selectedResume.ResumeID}/analysis", request);

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                saveError = $"Save failed: {error}";
                return;
            }

            MarkSelectedResumeAsAnalyzed();
            saveSuccess = "Resume analysis saved successfully.";
            
            // Auto-close the right panel upon successful save
            activeRightPanel = RightPanelView.None;
        }
        catch (Exception ex)
        {
            saveError = $"Error while saving: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private static DateTime? ParseDateOrNull(string? date)
    {
        if (string.IsNullOrWhiteSpace(date)) return null;

        if (DateTime.TryParseExact(date, "dd.MM.yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedDate))
        {
            return parsedDate;
        }
        return null;
    }

    private void MarkSelectedResumeAsAnalyzed()
    {
        if (selectedResume == null) return;

        selectedResume.IsAnalyzed = true;
        var resumeInList = resumes.FirstOrDefault(r => r.ResumeID == selectedResume.ResumeID);
        if (resumeInList != null)
        {
            resumeInList.IsAnalyzed = true;
        }

        StateHasChanged();
    }

    private async Task GetJobRecommendations()
    {
        if (selectedResume == null) return;

        isGettingJobs = true;
        jobError = null;
        
        // Open the right panel and set it to Jobs View
        activeRightPanel = RightPanelView.Jobs;

        try
        {
            var response = await Http.GetAsync($"api/resume/{selectedResume.ResumeID}/job-recommendations");

            if (response.IsSuccessStatusCode)
            {
                jobRecommendations = await response.Content.ReadFromJsonAsync<List<JobListingModel>>() ?? new List<JobListingModel>();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                jobError = error;
                jobRecommendations.Clear();
            }
        }
        catch (Exception ex)
        {
            jobError = $"Error calling job service: {ex.Message}";
            jobRecommendations.Clear();
        }
        finally
        {
            isGettingJobs = false;
        }
    }

    private string FormatJobSnippet(string snippet)
    {
        if (string.IsNullOrWhiteSpace(snippet)) return string.Empty;

        var cleaned = snippet.Replace("&nbsp;", " ");
        cleaned = System.Text.RegularExpressions.Regex.Replace(cleaned, @"[ ]{2,}", " ");
        cleaned = System.Text.RegularExpressions.Regex.Replace(cleaned, @"(?:\s*\.\.\.\s*)+", " ... ");
        cleaned = cleaned.Replace("●", "<br />&bull; ").Replace("•", "<br />&bull; ");

        return cleaned.Trim();
    }

    private void AddSkill()
    {
        var skill = (newSkillText ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(skill))
            return;

        editableSkillList.Add(skill);
        selectedSkillsForSearch.Add(skill);
        newSkillText = string.Empty;
        editingSkillIndex = null;
        editingSkillText = string.Empty;
    }

    private void RemoveSkillAt(int index)
    {
        if (index < 0 || index >= editableSkillList.Count)
            return;

        var removedSkill = editableSkillList[index];
        editableSkillList.RemoveAt(index);
        selectedSkillsForSearch.RemoveWhere(s => string.Equals(s, removedSkill, StringComparison.OrdinalIgnoreCase));

        if (editingSkillIndex == index)
        {
            editingSkillIndex = null;
            editingSkillText = string.Empty;
        }
        else if (editingSkillIndex.HasValue && editingSkillIndex.Value > index)
        {
            editingSkillIndex--;
        }
    }

    private void StartEditSkill(int index)
    {
        if (index < 0 || index >= editableSkillList.Count)
            return;

        editingSkillIndex = index;
        editingSkillText = editableSkillList[index];
    }

    private void SaveEditSkill()
    {
        if (!editingSkillIndex.HasValue)
            return;

        var oldSkill = editableSkillList[editingSkillIndex.Value];
        var updated = (editingSkillText ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(updated))
            return;

        editableSkillList[editingSkillIndex.Value] = updated;
        if (selectedSkillsForSearch.Remove(oldSkill))
        {
            selectedSkillsForSearch.Add(updated);
        }
        editingSkillIndex = null;
        editingSkillText = string.Empty;
    }

    private void CancelEditSkill()
    {
        editingSkillIndex = null;
        editingSkillText = string.Empty;
    }

    private void ToggleSkillSelection(string skill)
    {
        if (selectedSkillsForSearch.Contains(skill))
            selectedSkillsForSearch.Remove(skill);
        else
            selectedSkillsForSearch.Add(skill);
    }

    private static string FormatResumeTitle(string? title)
    {
        if (string.IsNullOrWhiteSpace(title))
            return string.Empty;

        return title.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase)
            ? title[..^4]
            : title;
    }
}