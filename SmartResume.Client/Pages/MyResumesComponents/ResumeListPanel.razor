@using SmartResume.Client.Models.Resume

<div class="col-xxl-2 col-xl-2 col-lg-3 col-md-4 mb-4 ps-0">
    <div class="resume-list-panel same-height-panel">

        <div class="resume-list-header">
            <h5 class="resume-list-title mb-0">
                <span class="resume-list-title-icon">
                    <i class="bi bi-collection-fill"></i>
                </span>
                <span>CV Library</span>
            </h5>
            <span class="resume-list-count">@Resumes.Count</span>
        </div>

        <div class="resume-list-body custom-scrollbar">
            @if (IsLoading)
            {
                <div class="text-center text-muted py-3">
                    <div class="spinner-border spinner-border-sm mb-2"></div>
                    <p class="small mb-0">Loading...</p>
                </div>
            }
            else if (Resumes.Count == 0)
            {
                <div class="text-center text-muted py-4 opacity-50">
                    <i class="bi bi-inbox display-6"></i>
                    <p class="mt-2 small mb-0">List is empty.</p>
                </div>
            }
            else
            {
                <div class="d-grid gap-2 pe-1">
                    @foreach (var resume in Resumes)
                    {
                        <ResumeListItem Resume="resume"
                                        IsActive="@(SelectedResumeId == resume.ResumeID)"
                                        OnSelect="OnSelectResume" />
                    }
                </div>
            }
        </div>

        <div class="resume-list-footer">
            <a href="upload-resume" class="btn btn-dark w-100 rounded-pill shadow-sm">
                <i class="bi bi-plus-lg me-2"></i> New Upload
            </a>
        </div>
    </div>
</div>

@code {
    [Parameter] public List<ResumeResponseModel> Resumes { get; set; } = new();
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public int? SelectedResumeId { get; set; }
    [Parameter] public EventCallback<ResumeResponseModel> OnSelectResume { get; set; }
}
